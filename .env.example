# BunkCraft serverinstellingen. Kopieer naar `.env` (naast docker-compose.yml) en pas aan.
# Alles is optioneel; de waarden hieronder zijn de standaardwaarden, tenzij anders vermeld.
# Uitleg per instelling: docs/SERVER.md

# --- Domein (alleen docker compose met Caddy) ---
# DOMAIN=play.example.com

# --- Server ---
PORT=3000
DATA_DIR=./data
# Achter een reverse proxy (Caddy, nginx): 1, anders zien alle spelers hetzelfde adres. docker-compose zet dit zelf.
TRUST_PROXY=0

# --- Hoofdwereld (knop "Join Public Server") ---
MAIN_WORLD=on
WORLD_NAME=BunkCraft Server
# SEED=bunk
GAMEMODE=survival
MOTD=Welcome to BunkCraft!
MAX_PLAYERS=20
# Operators van de hoofdwereld (komma-gescheiden namen)
# OPS=stijn,anna

# --- Games van spelers ---
ROOMS=on
MAX_ROOMS=200
ROOM_MAX_PLAYERS=12
ROOM_CREATE_LIMIT=6
ROOM_EXPIRE_DAYS=60
# Games in de publieke serverlijst (alleen games waarvan de maker "Show in Server List" aanzette)
LIST_MAX=50
# Foute wachtwoorden per adres per 10 minuten
PASSWORD_FAIL_LIMIT=5

# --- Beheer ---
# Zet een lang willekeurig geheim om /admin en /api/admin/* aan te zetten: openssl rand -hex 24
# ADMIN_TOKEN=
# Token voor /metrics (Prometheus). Zonder ADMIN_TOKEN en METRICS_TOKEN is /metrics alleen lokaal bereikbaar.
# METRICS_TOKEN=

# --- Verbindingen en veiligheid ---
MAX_CONNECTIONS=500
MAX_CONN_PER_IP=10
# Toegestane Origin-headers voor WebSocket en API (komma-gescheiden). Leeg = alles. `same-origin` = alleen de eigen host.
# ALLOWED_ORIGINS=https://play.example.com
# survival-inventory controleren: enforce (terugdraaien), warn (alleen loggen) of off
INVENTORY_GUARD=enforce
# Binaire snap/ent-frames voor clients die erom vragen (bespaart ~50% verkeer)
BINARY_PROTOCOL=on

# --- Back-ups en afsluiten ---
# Aantal back-ups per wereld in data/backups (0 = uit) en het interval in minuten
BACKUP_KEEP=12
BACKUP_INTERVAL_MIN=60
# Bij SIGTERM krijgen spelers de hint na zoveel milliseconden opnieuw te verbinden
RECONNECT_HINT_MS=8000

# --- Logs ---
# debug | info | warn | error
LOG_LEVEL=info
# json (een object per regel) | text
LOG_FORMAT=json
